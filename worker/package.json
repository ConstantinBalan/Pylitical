{
  "name": "pylitical-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/security.test.ts --bundle --platform=node --format=esm --outfile=.test-bundle.mjs --log-level=warning && node .test-bundle.mjs",
    "migrate:local": "wrangler d1 migrations apply pylitical --local",
    "migrate:remote": "wrangler d1 migrations apply pylitical --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.20.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}
