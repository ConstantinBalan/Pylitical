# Copy to env.sh (gitignored) and fill in, then before any terraform command:
#
#     source env.sh
#
# Three credentials must be present at once, and they are easy to mix up:
#
#   AWS_*                  the R2 token scoped to pylitical-tfstate. Terraform's
#                          S3 backend only reads AWS_-prefixed names, so an R2
#                          key wears AWS clothing here. R2 access keys are 32
#                          characters; if you see "length 20, should be 32",
#                          your AWS SSO profile has leaked in instead.
#
#   CLOUDFLARE_API_TOKEN   the Cloudflare provider token. Missing it produces
#                          error 9106, "Missing X-Auth-Key, X-Auth-Email or
#                          Authorization headers".
#
# Deliberately NOT here: R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY. Those belong
# to the *data* bucket token used by the Python pipeline, live in .env, and
# must stay separate -- CI writes archive data and must never reach state.

export AWS_ACCESS_KEY_ID="<32-char R2 access key for pylitical-tfstate>"
export AWS_SECRET_ACCESS_KEY="<its secret>"
export CLOUDFLARE_API_TOKEN="<Cloudflare API token: D1, Pages, Turnstile, Workers, R2 edit>"

# Guard against the AWS SSO profile winning over these.
unset AWS_PROFILE AWS_SESSION_TOKEN
